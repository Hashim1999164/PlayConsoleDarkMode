{
  "manifest_version": 3,
  "name": "Portal Dark Mode",
  "version": "1.3.0",
  "description": "Dark theme for web-based publisher and developer portals. One-click toggle; preference syncs in Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://play.google.com/console/*",
    "https://*.play.google.com/*",
    "https://admob.google.com/*",
    "https://*.admob.google.com/*",
    "https://apps.admob.com/*",
    "https://*.admob.com/*",
    "https://appstoreconnect.apple.com/*",
    "https://*.appstoreconnect.apple.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Portal Dark Mode"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.google.com/console",
        "https://play.google.com/console/*",
        "https://play.google.com/console/u/*",
        "https://admob.google.com/*",
        "https://*.admob.google.com/*",
        "https://apps.admob.com/*",
        "https://*.admob.com/*",
        "https://appstoreconnect.apple.com/*",
        "https://*.appstoreconnect.apple.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/dark-mode-filter.css", "content/dark-mode-asc.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/dark-mode.css",
        "content/dark-mode-filter.css",
        "content/dark-mode-asc.css"
      ],
      "matches": [
        "https://play.google.com/*",
        "https://admob.google.com/*",
        "https://*.admob.google.com/*",
        "https://apps.admob.com/*",
        "https://*.admob.com/*",
        "https://appstoreconnect.apple.com/*",
        "https://*.appstoreconnect.apple.com/*"
      ]
    }
  ]
}
